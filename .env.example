# 司寤运行时配置示例：复制为 .env（docker compose 会自动读取）
# 或者直接以环境变量注入。

# 监听地址与数据目录（本地直接运行时用）
SIWU_ADDR=:8788
SIWU_DATA_DIR=./data

# 对外地址：订阅链接与通知里的绝对地址都以它为准
SIWU_BASE_URL=http://localhost:8788

# 访问口令：留空则不做鉴权（只建议在回环或内网使用）
# SIWU_PASSWORD=change-me

# 订阅令牌：非空则 /f/*.xml 必须带 ?k=<token>（公开部署时保护订阅内容）
# SIWU_FEED_TOKEN=change-me-too

# 浏览器渲染通道：二选一
#   全局外置浏览器
# SIWU_BROWSER_WS=ws://browser:9222
#   或本机 Chrome 可执行文件
# SIWU_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# 并发抓取数
SIWU_WORKERS=4

# 允许访问内网地址（默认 false，防 SSRF）
SIWU_ALLOW_PRIVATE=false

# 调试日志
SIWU_DEBUG=false
