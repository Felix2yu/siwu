# Go 构建产物与本地数据
/bin/*
!/bin/.gitkeep
/data/
*.db
*.db-wal
*.db-shm
secret.key

# 前端依赖与产物
node_modules/
web/dist/
web/coverage/
web/.vite/

# 内嵌产物：只保留占位文件
internal/web/dist/*
!internal/web/dist/.gitkeep

# 测试与覆盖率
coverage.out
coverage.html

# 编辑器/系统
.DS_Store
Thumbs.db
desktop.ini

# 本地环境
.env
.env.local

# ---- 编辑器 / IDE 本地状态（不进版本库）----
.idea/
.vscode/
.vscode-test/
.history/
.fleet/
*.iml
*.swp
*.swo
*~

# ---- 系统垃圾文件（macOS / Windows / Linux 都会生成）----
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid

# ---- 通用本地缓存 / 测试产物（各仓再按技术栈补充）----
.cache/
.tmp/
.pnpm-store/
*.log
*.test
*.tsbuildinfo
.eslintcache
.stylelintcache
*.o
*.lo
*.la
*.a
*.so
*.dylib
*.dll
*.exe
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 密钥 / 签名文件（绝不入库）----
.env
.env.local
.env.*.local
secrets/
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# ---- Swift / Xcode 本地状态 ----
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

